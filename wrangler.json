{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "care-manager-quest",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
