import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import { buildTargetIndex, validateTargetAssignment, targetTaxonomy, smallConcepts, dataUrl, type Proposition } from './issue32-target-taxonomy.mts';
import { suggestAll } from './migrate-issue32-5x28.mts';

// Compare every fixed ID, label and parent with PR68's adopted design table.
const specification=readFileSync(new URL('TARGET_TAXONOMY_5X28.md',dataUrl),'utf8');
const table=[...specification.matchAll(/^\| ([1-5](?:\.[1-8])?) \| \*\*(.+?)\*\* \|/gm)]
  .map(([,id,label])=>({id,label,parent_id:id.includes('.')?id.split('.')[0]:null}));
assert.equal(table.length,33);
assert.deepEqual(targetTaxonomy.nodes.map(({id,label,parent_id})=>({id,label,parent_id})),table);
const result=buildTargetIndex();
assert.equal(result.index.length,6346);
assert.equal(new Set(result.index.map(r=>r.proposition_id)).size,6346);
assert.equal(new Set(result.index.map(r=>r.canonical_question_id)).size,1260);
assert.equal(new Set(result.index.map(r=>r.canonical_question_id+':'+r.choice_index)).size,6300);
assert.equal(new Set(result.rows.map(r=>r.taxonomy_assignment!.category_id)).size,28);
assert.equal(result.summary.semantic_reviewed,1774,'migration must not inflate old semantic approvals');
assert.ok(result.summary.migration_review_required>0,'uncertainty must not disappear');
for(const d of result.drawer_registry)assert.ok(smallConcepts.has(d.concept_id));
const byId=new Map(result.rows.map(r=>[r.taxonomy_assignment!.proposition_id,r]));
const target=(id:string)=>byId.get(id)!.taxonomy_assignment!.concept_id;
assert.equal(target('2009-33/c3/p1'),'4.4.pharmacology');
assert.equal(target('2009-33/c1/p1'),'4.6.medication_support');
assert.equal(target('2012-59/c3/p1'),'5.3.legal_guardianship');
assert.equal(target('2005-26/c4/p1'),'4.2.parkinsons','a disease comparison must not inherit an old ICF label');
assert.equal(target('2018-04/c5/p1'),'1.5.provider_designation');
assert.equal(target('2025-22/c1/p1'),'1.6.checklist');
assert.equal(target('2025-44/c4/p1'),'3.7.nursing_multi');
// Regression examples where the old label, a keyword or the case setting obscured the judgment target.
assert.equal(target('2013-30/c2/p1'),'4.6.food_care','meal assistance is not terminal care');
assert.equal(target('2006-33/c2/p1'),'4.4.pharmacology','drug excretion is not toileting care');
assert.equal(target('2012-29/c1/p1'),'4.4.adverse_effects','drug adverse effects are not medication assistance');
assert.equal(target('2020-24/c4/p1'),'3.6.tokuyo','a facility fee condition is not clinical terminal care');
assert.equal(target('2020-10/c3/p1'),'1.6.total_services','municipal program scope is not professional authority');
assert.equal(byId.get('2018-39/c1/p1')!.taxonomy_assignment!.attribute_id,'authority','unflagged legacy evaluation facet missed professional authority');
assert.equal(byId.get('2014-33/c4/p1')!.taxonomy_assignment!.attribute_id,'scope_care_worker_authority','professional authority is not staffing');
assert.equal(target('2015-26/c1/p1'),'4.4.lab','CRP is a cross-disease laboratory marker');
assert.equal(target('2008-42/c2/p1'),'1.3.specified_diseases','cancer eligibility is a certification condition');
assert.equal(target('2017-33/c1/p1'),'4.6.infection_control','standard precautions are infection-control practice');
assert.equal(target('2015-37/c3/p1'),'4.2.liver_digestive','an intestinal disease must not inherit the neurological rare-disease label');
assert.equal(target('2011-34/c1/p1'),'4.2.neurological','a wrong disease/symptom pair is classified by the disease being judged');
assert.equal(byId.get('2018-28/c1/p1')!.taxonomy_assignment!.attribute_id,'scope_tuberculosis_transmission','infection route is not a symptom');
assert.equal(byId.get('2017-29/c3/p1')!.taxonomy_assignment!.attribute_id,'scope_copd_treatment','a drug treatment is not a disease symptom');
const pendingAudit=structuredClone(byId.get('2014-42/c4/p1')!) as Proposition;
assert.equal(pendingAudit.taxonomy_assignment!.review_required,true,'a newly found boundary must enter the review queue');
assert.equal(pendingAudit.taxonomy_assignment!.classification_audit!.previous_assignment.review_required,false);
assert.ok(pendingAudit.taxonomy_assignment!.candidate_concept_ids.length>1);
pendingAudit.taxonomy_assignment!.review_required=false;
assert.throws(()=>validateTargetAssignment(pendingAudit),/audit\/review flag mismatch/);
assert.equal(target('2010-10/c1/p1'),'1.5.complaints','complaint handling is not payment review');
assert.equal(target('2009-11/c1/p1'),'1.5.disclosure','public disclosure must not inherit a generic authority label');
assert.equal(target('2007-34/c4/p1'),'3.2.visiting_rehab','a service fee condition is not provider designation');
assert.equal(target('2012-23/c3/p1'),'3.8.preventive_office','provider staffing is not an administrative designation action');
assert.equal(target('2010-10/c4/p1'),'1.5.nhi_federation','general NHI-federation duties need a separate concept');
assert.equal(target('2005-16/c3/p1'),'1.3.review_board','a certification judgment must not become an appeal just because an appeal board is mentioned');
assert.equal(byId.get('2014-04/c1/p1')!.taxonomy_assignment!.attribute_id,'appeal_scope','scope of appeal is not a time limit');
assert.equal(byId.get('2025-06/c4/p1')!.taxonomy_assignment!.attribute_id,'validity','renewal periods have their own facet');
assert.equal(byId.get('2008-13/c3/p1')!.taxonomy_assignment!.review_required,true,'compound complaint/investigation authority remains uncertain');
assert.equal(target('2006-12/c1/p1'),'1.6.legacy_prevention','historical prevention is not comprehensive support or modern general prevention');
assert.equal(target('2010-11/c1/p1'),'1.6.municipal_plan','a plan question must not inherit an old community-policy catch-all');
assert.equal(target('2020-13/c2/p1'),'1.6.plan_framework','national basic policy is distinct from the municipal plan');
assert.equal(target('2015-01/c5/p1'),'1.6.health_welfare','health and welfare programs are distinct from optional community-support projects');
assert.equal(target('2017-59/c4/p2'),'5.4.disability','the second proposition about disability law must not inherit the first proposition about care insurance');
assert.equal(target('2017-03/c5/p1'),'1.6.life_support','statutory coordinator placement is distinct from choosing a support agency');
assert.equal(target('2023-11/c3/p1'),'5.4.health_policy','the regional medical-care fund is not the municipal medical-linkage project');
assert.equal(target('2020-14/c4/p1'),'1.6.optional_projects','a membership question is organized by the system being tested, not the candidate meeting name');
assert.equal(byId.get('2025-22/c1/p1')!.taxonomy_assignment!.attribute_id,'questions','statutory checklist items are not individual assessment results');
assert.equal(byId.get('2010-20/c1/p1')!.taxonomy_assignment!.scope_qualifier,'旧介護予防事業','historical preventive care management must retain its era');
const audited=byId.get('2013-30/c2/p1')!;
const preserved=suggestAll([audited]);
assert.equal(preserved.errors.length,0);
assert.deepEqual(preserved.output[0],audited,'migration must not overwrite subsequent individual audits');
const stale=suggestAll([{...audited,proposition:audited.proposition+' changed'}]);
assert.equal(stale.errors.length,1,'a stale individual audit must fail instead of being overwritten');
const invalidAudit=structuredClone(audited) as Proposition;
invalidAudit.taxonomy_assignment!.classification_audit!.needed_knowledge='';
assert.throws(()=>validateTargetAssignment(invalidAudit),/audit evidence/);
invalidAudit.taxonomy_assignment!.classification_audit!.needed_knowledge='食事介助';
invalidAudit.taxonomy_assignment!.review_required=true;
assert.throws(()=>validateTargetAssignment(invalidAudit),/audit\/review flag mismatch/);
const row=byId.get('2009-33/c3/p1')!;
assert.throws(()=>validateTargetAssignment({...row,proposition:row.proposition+'変更'}),/stale/);
assert.throws(()=>validateTargetAssignment({...row,taxonomy_assignment:undefined}),/missing/);
assert.throws(()=>validateTargetAssignment({...row,taxonomy_assignment:{...row.taxonomy_assignment!,proposition_id:'2025-01/c1/p1'}}),/another proposition/);
assert.throws(()=>validateTargetAssignment({...row,taxonomy_assignment:{...row.taxonomy_assignment!,category_id:'3.1'}}),/mismatch/);
assert.throws(()=>validateTargetAssignment({...row,taxonomy_assignment:{...row.taxonomy_assignment!,concept_id:'4.4.fake'}}),/unknown/);
assert.throws(()=>validateTargetAssignment({...row,taxonomy_assignment:{...row.taxonomy_assignment!,reason:''}}),/evidence/);
assert.throws(()=>validateTargetAssignment({...row,taxonomy_assignment:{...row.taxonomy_assignment!,candidate_concept_ids:['4.4.fake']}}),/unknown candidate/);
assert.throws(()=>validateTargetAssignment({...row,taxonomy_assignment:{...row.taxonomy_assignment!,attribute_id:'bad.id'}}),/attribute ID/);
// Input changes, including reviewed legacy decisions, require reconsideration.
const altered=structuredClone(row) as Proposition;altered.subject_concept='服薬支援';
assert.throws(()=>validateTargetAssignment(altered),/stale/);
console.log('5x28 taxonomy regressions passed',JSON.stringify(result.summary));
